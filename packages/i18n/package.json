{
  "name": "@jsvision/i18n",
  "version": "1.5.3",
  "description": "Zero-dependency internationalization for JSVision applications and packages",
  "keywords": [
    "i18n",
    "internationalization",
    "localization",
    "tui",
    "terminal",
    "typescript"
  ],
  "homepage": "https://github.com/blendsdk/jsvision#readme",
  "bugs": "https://github.com/blendsdk/jsvision/issues",
  "license": "MIT",
  "author": "TrueSoftware B.V. <gevik@truesoftware.nl>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/blendsdk/jsvision.git",
    "directory": "packages/i18n"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node/index.d.ts",
      "import": "./dist/node/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "bench": "node bench/i18n-bench.mjs",
    "build": "tsc",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "test": "vitest run --project unit",
    "test:e2e": "vitest run --project e2e --passWithNoTests",
    "check:deps": "node ../../scripts/check-no-native-deps.mjs .",
    "check:docs": "node ../../scripts/check-jsdoc.mjs ."
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "vitest": "^4.1.10"
  }
}
